# 数据库（默认 SQLite，生产可切 MySQL：mysql+aiomysql://user:pass@host:3306/hutu_agent）
HUTU_DB_URL=sqlite+aiosqlite:///./hutu_agent.db

# LLM（OpenAI 兼容协议，如 AIHub / one-api / vLLM）
HUTU_LLM_BASE_URL=https://api.example.com/v1
HUTU_LLM_API_KEY=sk-xxx
HUTU_LLM_MODEL=gpt-4o-mini
# 无 Key 演示模式：置 1 后不调用真实 LLM，逐字回显
HUTU_LLM_FAKE=0

# 默认 Agent
HUTU_AGENT_SYSTEM_PROMPT=你是一个乐于助人的通用智能助手。

# dev 固定用户（MVP 无 SSO）
HUTU_DEV_USER_ID=dev-user
HUTU_DEV_USER_NAME=开发用户
